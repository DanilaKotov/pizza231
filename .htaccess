RewriteEngine On

# Исключить существующие PHP файлы из обработки маршрутизатором
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Исключить существующие директории
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Остальные запросы направлять в index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.php [QSA,L]